<!DOCTYPE html>
<html>
    <head>
        <title>Message Details</title>
        <link rel="stylesheet" href="/style.css">
    </head>

    <body>
        <div class="message-details">
            <h1>Message Details</h1>

            <div class="detail-card">
                <p><b>Sender Name:</b> <%= message.username %></p>
                <p><b>Text:</b> <%= message.message %></p>
                <p><b>Added Date:</b> <%= message.added %></p>

                <a href="/" class="back-button">← Back to Messages</a>
            </div>
        </div>
    </body>
</html>