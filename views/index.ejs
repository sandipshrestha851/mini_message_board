<!DOCTYPE html>
<html>
    <head>
        <title>Mini Messageboard</title>
        <link rel="stylesheet" href="style.css">
    </head>
    <body>
        <h1>Messages</h1>
        <% messages.forEach((message,index) => { %>
            <p><b><%= message.user%>:</b><%= message.text %></p>
            <p>added in : <%= message.added %> </p>
            <button><a href="/message/<%= index %>">Open</a></button>
        <% }) %>
        <a href="/new" target="_self" rel="noopener noreferrer">Add message</a>
    </body>
</html>